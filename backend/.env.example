# Safe local defaults; credentials are deliberately blank. Copy to backend/.env.
APP_NAME=StayScape
CURRENCY_CODE=USD
# JSON list. Replace/add the exact Vercel production origin after deployment.
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Omit locally for the default SQLite path. Docker sets a read-only URI automatically.
# DATABASE_URL=sqlite+aiosqlite:///C:/PATH/TO/stayscape.db
# Provider-free by default. Set false only when configuring your chosen provider.
SEARCH_DEMO_MODE=true
SEARCH_BASE_URL=https://api.groq.com/openai/v1
SEARCH_API_KEY=
SEARCH_MODEL=
SEARCH_TIMEOUT_SECONDS=6
SEARCH_RATE_PER_MINUTE=20
# Existing optional overrides: REGIONS_FILE / PRICING_FILE (absolute JSON paths).
